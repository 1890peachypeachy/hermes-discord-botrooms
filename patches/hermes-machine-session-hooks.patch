+# Public contract for trusted machine clients. Increment only for a breaking
+# schema or lifecycle change; standalone integrations feature-detect this.
+MACHINE_SESSION_HOOKS_VERSION = 1
+_SUPPORTED_EVENT_SUBSCRIPTIONS = frozenset({"tool_lifecycle"})
+
+
+def _normalize_event_subscriptions(value) -> frozenset[str]:
+    """Validate opt-in machine event families for one client session."""
+
+    if value in (None, ""):
+        return frozenset()
+    if not isinstance(value, (list, tuple, set, frozenset)):
+        raise ValueError("event_subscriptions must be a list of strings")
+    if any(not isinstance(item, str) for item in value):
+        raise ValueError("event_subscriptions must be a list of strings")
+    normalized = frozenset(
+        item.strip().lower() for item in value if item.strip()
+    )
+    unknown = normalized - _SUPPORTED_EVENT_SUBSCRIPTIONS
+    if unknown:
+        raise ValueError(
+            "unsupported event_subscriptions: " + ", ".join(sorted(unknown))
+        )
+    return normalized
+
+
 def _session_verbose(sid: str) -> bool:
     return _session_tool_progress_mode(sid) == "verbose"
 
 
 def _tool_progress_enabled(sid: str) -> bool:
+    session = _sessions.get(sid, {})
+    if "tool_lifecycle" in session.get("event_subscriptions", ()):
+        # Machine consumers such as schedulers need the authoritative start /
+        # complete pair even when the human-facing progress display is off.
+        return True
     return _session_tool_progress_mode(sid) != "off"
 
 
